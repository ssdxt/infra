{
  "title": "Cilium Gateway (wuxing.local)",
  "uid": "cilium-gateway",
  "tags": ["cilium", "gateway-api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "stat", "title": "Gateway 活跃连接", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
     "targets": [{"expr": "sum(envoy_http_downstream_cx_active)", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "请求速率 (rps)", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
     "targets": [{"expr": "sum(rate(envoy_http_downstream_rq_total[5m]))", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "5xx 速率 (rps)", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
     "targets": [{"expr": "sum(rate(envoy_http_downstream_rq_total{envoy_response_code_class=\"5\"}[5m])) or vector(0)", "refId": "A"}],
     "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.1}]}}}},
    {"id": 4, "type": "stat", "title": "Hubble 转发速率 (flows/s)", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
     "targets": [{"expr": "sum(rate(cilium_forward_count_total[5m]))", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Gateway 总请求速率（按响应码段）", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
     "targets": [{"expr": "sum by (envoy_response_code_class) (rate(envoy_http_downstream_rq_total[5m]))", "legendFormat": "{{envoy_response_code_class}}xx", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "按后端上游请求速率（rps）", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
     "targets": [{"expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total[5m])) > 0", "legendFormat": "{{envoy_cluster_name}}", "refId": "A"}]},
    {"id": 7, "type": "timeseries", "title": "活跃连接数", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 9, "w": 12, "x": 0, "y": 14},
     "targets": [{"expr": "sum(envoy_http_downstream_cx_active)", "legendFormat": "downstream", "refId": "A"},
                 {"expr": "sum(envoy_http_downstream_cx_destroyed_total)", "legendFormat": "destroyed(cum)", "refId": "B"}]},
    {"id": 8, "type": "timeseries", "title": "Cilium 转发/丢弃包速率", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 9, "w": 12, "x": 12, "y": 14},
     "targets": [{"expr": "sum(rate(cilium_forward_count_total[5m]))", "legendFormat": "forward", "refId": "A"},
                 {"expr": "sum(rate(cilium_drop_count_total[5m]))", "legendFormat": "drop", "refId": "B"}]},
    {"id": 9, "type": "timeseries", "title": "证书/组件 up", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 7, "w": 24, "x": 0, "y": 23},
     "targets": [{"expr": "up{job=~\"serviceMonitor/kube-system/cilium.*\"}", "legendFormat": "{{job}} {{instance}}", "refId": "A"}]}
  ]
}
